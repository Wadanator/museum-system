{
  "sceneId": "window_open_hold_close_test",
  "description": "Display ON, wait 5 seconds, open windows at 70% with a 7-second offset, play ghost2.mp4 for 10 seconds, close at 80%, then display OFF.",
  "version": "1.0",
  "initialState": "DISPLAY_ON",
  "states": {
    "DISPLAY_ON": {
      "description": "Turn on the display and allow 5 seconds to wake up.",
      "onEnter": [
        {"action": "video", "message": "STOP_VIDEO"},
        {"action": "mqtt", "topic": "room1/display", "message": "ON"}
      ],
      "transitions": [
        {"type": "timeout", "delay": 7, "goto": "OPEN_WINDOW"}
      ]
    },
    "OPEN_WINDOW": {
      "description": "Open left at 70%, right after 7 seconds, then reopen right at 14 seconds for an extra 2 seconds before video.",
      "onEnter": [
        {
          "action": "mqtt",
          "topic": "room1/window/left",
          "message": "OPEN:70"
        }
      ],
      "timeline": [
        {
          "at": 7.0,
          "action": "mqtt",
          "topic": "room1/window/right",
          "message": "OPEN:70"
        },
        {
          "at": 14,
          "action": "mqtt",
          "topic": "room1/window/right",
          "message": "OPEN:70"
        },
        {
          "at": 16,
          "action": "mqtt",
          "topic": "room1/window/right",
          "message": "STOP"
        }
      ],
      "transitions": [
        {
          "type": "timeout",
          "delay": 17,
          "goto": "HOLD_OPEN"
        }
      ]
    },
    "HOLD_OPEN": {
      "description": "Play ghost2.mp4 with windows open for 10 seconds.",
      "onEnter": [
        {"action": "video", "message": "PLAY_VIDEO:fullhd-otoceny-monitor-slova.mp4"}
      ],
      "transitions": [
        {
          "type": "timeout",
          "delay": 25,
          "goto": "CLOSE_WINDOW"
        }
      ]
    },
    "CLOSE_WINDOW": {
      "description": "Stop video and close both window sides at 80%.",
      "onEnter": [
        {"action": "video", "message": "STOP_VIDEO"},
        {
          "action": "mqtt",
          "topic": "room1/window/left",
          "message": "CLOSE:80"
        },
        {
          "action": "mqtt",
          "topic": "room1/window/right",
          "message": "CLOSE:80"
        }
      ],
      "transitions": [
        {
          "type": "timeout",
          "delay": 11.0,
          "goto": "END"
        }
      ]
    },
    "END": {
      "description": "Scene finished.",
      "onEnter": [
        {"action": "video", "message": "STOP_VIDEO"},
        {"action": "mqtt", "topic": "room1/display", "message": "OFF"}
      ]
    }
  }
}
