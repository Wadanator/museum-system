[MQTT]
broker_ip = 127.0.0.1
port = 1883
device_timeout = 15
feedback_timeout = 1
command_ack_timeout_ms = 700
node_offline_timeout_s = 5

[GPIO]
button_pin = 27
debounce_time = 300

[Room]
room_id = room1

[Scenes]
directory = scenes

[Audio]
directory = audio
max_init_attempts = 3
init_retry_delay = 5

[Video]
directory = videos
ipc_socket = /tmp/mpv_socket
iddle_image = black.png
hwdec = auto-safe
video_output = gpu
gpu_context = drm
hwdec_codecs = h264,hevc
framedrop = vo
mpv_extra_args =
health_check_interval = 60
max_restart_attempts = 3
restart_cooldown = 60

[System]
health_check_interval = 120
main_loop_sleep = 0.1
mqtt_check_interval = 60
scene_processing_sleep = 0.005
web_dashboard_port = 5000
mqtt_retry_attempts = 3
mqtt_retry_sleep = 2
mqtt_connect_timeout = 10
mqtt_reconnect_timeout = 5
mqtt_reconnect_sleep = 0.5
scene_buffer_time = 1
device_cleanup_interval = 2
scene_heartbeat_interval = 60
scene_wait_poll_interval = 30
# Raise above your longest expected scene duration for ambient or multi-hour installations.
scene_wait_max_seconds = 7200

[Json]
json_file_name = SceneV01.json

[Startup]
# Runtime startup mode: classic | ambient
mode = classic

# Scene file used in ambient mode. If empty, [Json] json_file_name is used.
ambient_scene =

# Policy for the first ambient start:
# - after_initial_connection_attempt: try MQTT first, then start even in offline mode.
# - wait_for_mqtt: do not start until MQTT is connected/restored.
ambient_start_policy = after_initial_connection_attempt

# Delay between normal ambient scene cycles.
ambient_restart_delay_seconds = 2

# Delay before retrying when the ambient scene is missing or fails to load.
ambient_error_retry_seconds = 30

# Normal ambient cycle cleanup:
# - scene_only: do not broadcast global room STOP between normal cycles.
# - full_stop: use the same force-off/STOP cleanup as classic scene end.
ambient_cycle_cleanup = scene_only

# In ambient mode, default START commands should not create duplicate starts.
ambient_ignore_default_start = true

# Operator/dashboard/named scene starts are explicit actions.
ambient_allow_named_scene_start = true

# Operator Stop behavior in ambient mode:
# - suspend_until_restart: stop now and stay suspended until service restart/future resume.
# - resume_after_delay: restart after ambient_restart_delay_seconds.
ambient_stop_behavior = suspend_until_restart

[Logging]
log_level = INFO
log_directory = logs
max_file_size_mb = 5
backup_count = 3
daily_backup_days = 7
console_colors = false
file_logging = true
console_logging = false
log_format = detailed

[LogLevels]
# Core system components - use exact logger names from get_logger(...)
museum.main = INFO
museum.watchdog = INFO
museum.sceneparser = INFO
museum.statemachine = WARNING
museum.stateexecutor = WARNING
museum.transitionmanager = WARNING
museum.servicecontainer = INFO
museum.btn_handler = WARNING
museum.sys_monitor = WARNING
museum.device_outage_tracker = WARNING
museum.config = WARNING
museum.bootstrap = INFO

# MQTT and device state
museum.mqtt = WARNING
museum.mqtt_handler = WARNING
museum.mqtt_feedback = WARNING
museum.mqtt_devices = WARNING
museum.actuator_store = WARNING

# Media and web dashboard
museum.audio = WARNING
museum.video = INFO
museum.web = INFO

# External libraries - suppress unless critical
werkzeug = ERROR
flask = ERROR
urllib3 = ERROR
paho = ERROR
socketio = ERROR
engineio = ERROR
